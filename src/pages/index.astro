---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import StatsBar from '../components/StatsBar.astro';
import WhoWeAre from '../components/WhoWeAre.astro';
import QuickLinks from '../components/QuickLinks.astro';
import TeamSection from '../components/TeamSection.astro';
import PlacementsSection from '../components/PlacementsSection.astro';
import ContactCTA from '../components/ContactCTA.astro';
---

<Layout
  title="Home"
  description="The Nittany Lion Fund is a student-managed investment fund at Penn State's Smeal College of Business, managing over $23MM AUM for accredited investors since 2005."
>
  <HeroSection />
  <StatsBar />
  <WhoWeAre />
  <QuickLinks />
  <TeamSection />
  <PlacementsSection />
  <ContactCTA />
</Layout>

<!-- ── Announcement Popup ─────────────────────────────────── -->
<div
  id="announcement-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="announcement-title"
  style="
    position: fixed; inset: 0; z-index: 9999;
    display: flex; align-items: center; justify-content: center;
    padding: 1rem;
    background: rgba(0, 10, 30, 0.72);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    animation: fade-in 0.35s ease both;
  "
>
  <div
    style="
      background: var(--color-navy);
      border: 1px solid rgba(77,136,190,0.35);
      border-top: 4px solid var(--color-pugh);
      border-radius: 1rem;
      box-shadow: 0 24px 60px rgba(0,0,0,0.5);
      max-width: 460px; width: 100%;
      padding: 2rem 2rem 1.75rem;
      position: relative;
      text-align: center;
      animation: slide-up 0.35s var(--ease-smooth) both;
    "
  >
    <!-- Close button -->
    <button
      id="announcement-close"
      aria-label="Close announcement"
      style="
        position: absolute; top: 1rem; right: 1rem;
        background: rgba(255,255,255,0.08);
        border: none; border-radius: 50%;
        width: 2rem; height: 2rem;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; color: rgba(255,255,255,0.6);
        transition: background 0.15s, color 0.15s;
      "
    >
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>

    <!-- Badge -->
    <p style="
      display: inline-block;
      font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--color-pugh);
      background: rgba(77,136,190,0.15);
      border-radius: 999px;
      padding: 0.25rem 0.75rem;
      margin-bottom: 1rem;
    ">
      Announcement
    </p>

    <!-- Title -->
    <h2
      id="announcement-title"
      style="
        font-family: var(--font-serif);
        font-weight: 700;
        font-size: clamp(1.2rem, 4vw, 1.5rem);
        color: #fff;
        line-height: 1.25;
        margin-bottom: 0.75rem;
      "
    >
      PSIA General Body Meeting
    </h2>

    <!-- Body -->
    <p style="color: rgba(255,255,255,0.75); font-size: 0.9375rem; line-height: 1.6; margin-bottom: 1.5rem; text-align: center;">
      Penn State Investment Association is having its <strong style="color:#fff;">first general body meeting today, September 2nd</strong>, from <strong style="color:#fff;">6 PM – 7 PM</strong> in <strong style="color:#fff;">Forum 105</strong>.
    </p>

    <!-- Dismiss -->
    <button
      id="announcement-dismiss"
      style="
        width: 100%;
        background: var(--color-pugh);
        color: #fff;
        font-weight: 700;
        font-size: 0.9375rem;
        border: none;
        border-radius: 0.625rem;
        padding: 0.75rem 1.5rem;
        cursor: pointer;
        transition: opacity 0.15s, transform 0.15s;
      "
    >
      Dismiss
    </button>
  </div>
</div>

<style>
  @keyframes fade-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes slide-up {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  #announcement-close:hover,
  #announcement-close:focus {
    background: rgba(255,255,255,0.16) !important;
    color: #fff !important;
  }
  #announcement-dismiss:hover,
  #announcement-dismiss:focus {
    opacity: 0.85;
    transform: translateY(-1px);
  }
  @media (prefers-reduced-motion: reduce) {
    #announcement-overlay,
    #announcement-overlay > div { animation: none !important; }
  }
</style>

<script>
  function closePopup() {
    const overlay = document.getElementById('announcement-overlay');
    if (overlay) {
      overlay.style.opacity = '0';
      overlay.style.transition = 'opacity 0.2s ease';
      setTimeout(() => overlay.remove(), 200);
    }
  }
  document.getElementById('announcement-close')?.addEventListener('click', closePopup);
  document.getElementById('announcement-dismiss')?.addEventListener('click', closePopup);
  document.getElementById('announcement-overlay')?.addEventListener('click', (e) => {
    if (e.target === document.getElementById('announcement-overlay')) closePopup();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closePopup();
  });
</script>
