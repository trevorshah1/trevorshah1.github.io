---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact"
  description="Get in touch with the Nittany Lion Fund at Penn State's Smeal College of Business."
>

  <!-- ── Hero ─────────────────────────────────────────────────── -->
  <section
    class="relative flex items-center justify-center overflow-hidden"
    style="min-height: 40vh; background-color: var(--color-navy);"
    aria-labelledby="contact-hero-heading"
  >
    <div class="absolute inset-0 bg-cover bg-no-repeat" aria-hidden="true"
      style="background-image: url('/images/contact-hero.jpg'); background-position: center 30%;"></div>
    <div class="absolute inset-0" aria-hidden="true"
      style="background:linear-gradient(160deg,rgba(0,10,30,0.60) 0%,rgba(0,20,55,0.70) 100%);"></div>
    <div class="relative z-10 text-center px-4 sm:px-6 lg:px-8 py-20 max-w-3xl mx-auto">
      <p class="section-label mb-4" style="color:var(--color-pugh);">Reach Out</p>
      <h1
        id="contact-hero-heading"
        class="font-serif font-bold text-white text-4xl sm:text-5xl lg:text-6xl leading-tight tracking-tight"
        style="animation:fade-up 0.8s var(--ease-smooth) 0.1s both;"
      >Contact Us</h1>
    </div>
  </section>

  <!-- ── GroupMe Invite ───────────────────────────────────────── -->
  <section class="py-20 sm:py-28 bg-white">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

      <div class="mb-10 reveal">
        <p class="section-label mb-3">Join the Conversation</p>
        <h2 class="font-serif font-bold text-3xl sm:text-4xl" style="color:var(--color-navy);">
          Connect With Us on GroupMe
        </h2>
        <p class="mt-3 text-base" style="color:var(--color-slate);">
          Join our GroupMe to stay up to date with announcements, events, and more.
        </p>
      </div>

      <div class="reveal">
        <a
          href="https://groupme.com/join_group/112607891/Fqh33h20"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-block w-full rounded-2xl overflow-hidden transition-all duration-300 hover:-translate-y-1.5"
          style="box-shadow:0 4px 24px rgba(0,30,68,0.12);"
        >
          <!-- Card header -->
          <div class="flex items-center gap-4 px-6 py-5" style="background:#00AFF0;">
            <div class="flex-shrink-0 flex items-center justify-center w-12 h-12 rounded-xl"
              style="background:rgba(255,255,255,0.20);">
              <!-- GroupMe speech-bubble icon -->
              <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2C6.477 2 2 6.145 2 11.243c0 3.022 1.536 5.71 3.938 7.431V22l3.361-1.85c.895.248 1.843.381 2.824.381 5.523 0 10-4.145 10-9.243C22 6.145 17.523 2 12 2zm1.008 12.454l-2.548-2.714-4.976 2.714 5.476-5.813 2.61 2.713 4.914-2.713-5.476 5.813z"/>
              </svg>
            </div>
            <div class="flex-1 min-w-0 text-left">
              <p class="font-bold text-white text-base leading-tight">Nittany Lion Fund</p>
              <p class="text-sm mt-0.5" style="color:rgba(255,255,255,0.80);">GroupMe Community</p>
            </div>
            <svg class="w-5 h-5 flex-shrink-0 text-white opacity-70 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </div>
          <!-- Card body -->
          <div class="px-6 py-5 bg-white text-left">
            <p class="text-sm leading-relaxed" style="color:var(--color-charcoal);">
              Get real-time updates on recruiting events, info sessions, application deadlines, and fund announcements — all in one place.
            </p>
            <p class="mt-3 text-sm font-bold" style="color:#00AFF0;">Join the GroupMe →</p>
          </div>
        </a>
      </div>

    </div>
  </section>

  <!-- ── Social media cards ────────────────────────────────────── -->
  <section class="py-20 sm:py-24" style="background:var(--color-cream);">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center mb-12 reveal">
        <p class="section-label mb-3">Stay Connected</p>
        <h2 class="font-serif font-bold text-3xl sm:text-4xl" style="color:var(--color-navy);">Follow Us</h2>
      </div>

      <div class="reveal grid grid-cols-1 sm:grid-cols-2 gap-6">

        <!-- Instagram -->
        <a href="https://www.instagram.com/nittanylionfund/?hl=en"
          target="_blank" rel="noopener noreferrer"
          class="group block rounded-2xl overflow-hidden transition-all duration-300 hover:-translate-y-1.5"
          style="box-shadow:0 4px 20px rgba(0,0,0,0.10);"
        >
          <div class="flex items-center gap-4 px-6 py-5"
            style="background:linear-gradient(135deg,#833ab4 0%,#fd1d1d 50%,#fcb045 100%);">
            <div class="flex-shrink-0 flex items-center justify-center w-11 h-11 rounded-xl"
              style="background:rgba(255,255,255,0.20);">
              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="font-bold text-white text-sm leading-tight">Nittany Lion Fund</p>
              <p class="text-xs mt-0.5" style="color:rgba(255,255,255,0.75);">@nittanylionfund</p>
            </div>
            <svg class="w-4 h-4 flex-shrink-0 text-white opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </div>
          <div class="px-6 py-4 bg-white">
            <p class="text-sm leading-relaxed" style="color:var(--color-charcoal);">
              Behind-the-scenes content, Wall Street trips, speaker events, and fund manager highlights.
            </p>
            <p class="mt-2 text-sm font-semibold" style="color:#c13584;">View on Instagram →</p>
          </div>
        </a>

        <!-- LinkedIn -->
        <a href="https://www.linkedin.com/company/nittanylionfundpsu/posts/?feedView=all"
          target="_blank" rel="noopener noreferrer"
          class="group block rounded-2xl overflow-hidden transition-all duration-300 hover:-translate-y-1.5"
          style="box-shadow:0 4px 20px rgba(0,0,0,0.10);"
        >
          <div class="flex items-center gap-4 px-6 py-5" style="background:#0A66C2;">
            <div class="flex-shrink-0 flex items-center justify-center w-11 h-11 rounded-xl"
              style="background:rgba(255,255,255,0.20);">
              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="font-bold text-white text-sm leading-tight">Nittany Lion Fund</p>
              <p class="text-xs mt-0.5" style="color:rgba(255,255,255,0.75);">Penn State · Smeal College of Business</p>
            </div>
            <svg class="w-4 h-4 flex-shrink-0 text-white opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </div>
          <div class="px-6 py-4 bg-white" style="border-bottom: 2px solid #E5E7EB;">
            <p class="text-sm leading-relaxed" style="color:var(--color-charcoal);">
              Alumni placements, recruiting announcements, company updates, and industry news.
            </p>
            <p class="mt-2 text-sm font-semibold" style="color:#0A66C2;">View on LinkedIn →</p>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- ── Quick contact bar ─────────────────────────────────────── -->
  <div style="background:var(--color-navy);padding:2.5rem 1.5rem;">
    <div class="max-w-2xl mx-auto flex flex-col sm:flex-row items-center justify-center gap-8 text-center sm:text-left">
      <div class="flex items-center gap-3">
        <div class="flex-shrink-0 flex items-center justify-center w-9 h-9 rounded-lg" style="background:rgba(255,255,255,0.10);">
          <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
        </div>
        <div>
          <p class="text-xs font-bold tracking-widest uppercase" style="color:rgba(255,255,255,0.45);">Email</p>
          <a href="mailto:nittanylionfund@psu.edu" class="text-sm font-medium text-white hover:underline">
            nittanylionfund@psu.edu
          </a>
        </div>
      </div>
      <div class="hidden sm:block" style="width:1px;height:2.5rem;background:rgba(255,255,255,0.15);"></div>
      <div class="flex items-center gap-3">
        <div class="flex-shrink-0 flex items-center justify-center w-9 h-9 rounded-lg" style="background:rgba(255,255,255,0.10);">
          <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </div>
        <div>
          <p class="text-xs font-bold tracking-widest uppercase" style="color:rgba(255,255,255,0.45);">Location</p>
          <p class="text-sm font-medium text-white">Smeal College of Business, University Park PA</p>
        </div>
      </div>
    </div>
  </div>

</Layout>

